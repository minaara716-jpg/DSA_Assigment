"""ITECC04 Laboratory 4, Part A2: the linked-list-based stack.

Same public interface as ArrayStack. Different storage, same contract.
The HEAD of the list is the top.

Pushing means making a new node whose next is the old top.
Popping means moving the head forward one node.
Both operations are O(1).
"""


class Node:
    """Node for the linked stack."""

    _slots_ = ("value", "next")

    def __init__(self, value, nxt=None):
        self.value = value
        self.next = nxt


class LinkedStack:

    def __init__(self):
        """Create an empty stack."""
        self._top = None
        self._size = 0

    def push(self, item):
        """Add an item to the top of the stack."""
        self._top = Node(item, self._top)
        self._size += 1

    def pop(self):
        """Remove and return the top item."""
        if self.is_empty():
            raise IndexError("pop from an empty stack")

        node = self._top
        self._top = node.next
        self._size -= 1

        return node.value

    def peek(self):
        """Return the top item without removing it."""
        if self.is_empty():
            raise IndexError("peek at an empty stack")

        return self._top.value

    def is_empty(self):
        """Return True if the stack is empty."""
        return self._top is None

    def size(self):
        """Return the number of items in the stack."""
        return self._size

    def __len__(self):
        """Return the number of items in the stack."""
        return self.size()
